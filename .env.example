# Port Configurations
APP_PORT=<Backend server port, ussually 5000 on Windows or Linux and 5001 on MacOS>
DB_PORT=<Database port, ussually 5432>
FRONTEND_PORT=<Frontend server port, ussually 3000>

# Database Credentials
POSTGRES_USER=<database_user_name>
POSTGRES_PASSWORD=<database_user_password>
POSTGRES_DB=<database name>
