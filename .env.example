# Port Configurations
LOCAL_BACKEND_PORT=<Local Backend container port, ussually 5000>
LOCAL_BACKEND_URL=<Local Backend url, ussually http://localhost:5000>
REMOTE_BACKEND_PORT=<Remote Backend server port, ussually 5001>
REMOTE_BACKEND_URL=<Remote Backend url, ussually http://localhost:5001>
DB_PORT=<Database port, ussually 5432>
FRONTEND_PORT=<Frontend server port, ussually 3000>

# Database Credentials
POSTGRES_USER=<database_user_name>
POSTGRES_PASSWORD=<database_user_password>
POSTGRES_DB=<database name>
