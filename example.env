# Port Configurations
LOCAL_BACKEND_PORT=<Local Backend container port, usually 5000>
LOCAL_BACKEND_URL=<Local Backend url, usually http://localhost:5000>
REMOTE_BACKEND_PORT=<Remote Backend server port, usually 5001>
REMOTE_BACKEND_URL=<Remote Backend url, usually http://localhost:5001>
DB_PORT=<Database port, usually 5432>
FRONTEND_PORT=<Frontend server port, usually 8081>

# Database Credentials
POSTGRES_USER=<database_user_name>
POSTGRES_PASSWORD=<database_user_password>
POSTGRES_DB=<database name>

# Authentication credentials
JWT_SECRET=<Long JWT secret>

# Email credentials
EMAIL_HOST=<smtp.gmail.com or sandbox.smtp.mailtrap.io>
EMAIL_PORT=<Email port, ussually: 2525 for sandbox, or 587 for live gmail>
EMAIL_USER=<A real Gmail address>
EMAIL_PASSWORD=<Gmail app password, see docs/gmail-app-password.md>

# Expo credentials
EXPO_TOKEN=<Expo personal access token>
