TYPESAFE_API_KEY=

# Address of the local Ollama Server's endpoint
OLLAMA_URL=http://localhost:11434/api/chat

# Ollama model tag for query answering (use the -instruct build, not plain qwen3:4b)
ANSWER_MODEL=qwen3:4b-instruct


# Address of the local Ollama Server's embedding endpoint
EMBED_URL=http://localhost:11434/api/embed

# Ollama model tag for text embeddings (transcripts and questions)
EMBED_MODEL=embeddinggemma:300m

# Hugging Face model name for audio transcription
TRANSCRIBE_MODEL=openai/whisper-base.en
