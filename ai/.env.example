TYPESAFE_API_KEY=

# Whethor classification should first try sending TypeSafe API requests for classification, and then fallback to a local decision model if TypeSafe encounters an error OR if classification should go directly to a local decision model
TRY_API_THEN_LOCAL=True
# What decision model from HuggingFace to use as fallback to TypeSafe/local only for if a transcript is memorable or not
LOCAL_TRIGGER_MODEL=carrtesy/EXAONE-4.0-1.2B-JEV

# Address of the local Ollama Server's endpoint
OLLAMA_URL=http://localhost:11434/api/chat

# Ollama model tag for query answering (use the -instruct build, not plain qwen3:4b)
ANSWER_MODEL=qwen3:4b-instruct


# Address of the local Ollama Server's embedding endpoint
EMBED_URL=http://localhost:11434/api/embed

# Ollama model tag for text embeddings (transcripts and questions)
EMBED_MODEL=embeddinggemma:300m

# Hugging Face model name for audio transcription
TRANSCRIBE_MODEL=openai/whisper-base.en

# Whethor or not TRANSCRIBE_MODEL is a multilingual model or not; Set to 'True' if it can do multiple languages and 'False' if it can only do one
MODEL_IS_MULTILINGUAL=False

# Address of the backend's transcript search endpoint
SEARCH_URL=http://localhost:5001/search

# Secret this service sends to the backend's search endpoint (keep the value out of git)
BACKEND_API_KEY=

# Secret the backend must send to this service's /audio and /query (keep the value out of git)
AI_API_KEY=
